# ───────── AGENCY OS ─────────
# Entorno: development | production. En production se exige Supabase y secretos fuertes.
APP_ENV=development

# Backend de datos: local (JSON en .data/, con datos demo) | supabase
DATA_BACKEND=local

# Autenticación modo local (una sola cuenta). En production es obligatorio.
AGENCY_OS_PASSWORD=
# Secreto para firmar la cookie de sesión (mín. 32 caracteres). openssl rand -hex 32
AUTH_SECRET=

# ───────── Supabase (DATA_BACKEND=supabase) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ───────── Claude API ─────────
# Sin clave, los agentes quedan "configurados" pero NO operativos.
ANTHROPIC_API_KEY=
# Modelo por defecto de los agentes
CLAUDE_MODEL=claude-opus-5-5
# Límites de ejecución
MAX_AGENT_RUNS_PER_DAY=40
DAILY_AI_BUDGET_USD=5
MAX_PLAN_TASKS=8

# ───────── n8n ─────────
# URL base de tu instancia, p. ej. https://n8n.midominio.com
N8N_BASE_URL=
# Secreto compartido para firmar webhooks (HMAC-SHA256) en ambos sentidos
N8N_WEBHOOK_SECRET=
# Solo para webhooks entrantes de n8n con DATA_BACKEND=supabase (servidor, nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=
# UUID del usuario de Supabase al que se asignan los datos que llegan por webhook
N8N_OWNER_ID=
